---
// Same header behavior as the order-landing-page engine's Header.tsx v3:
// fully transparent at the top of the page (sits directly on the hero
// photo, no bar), gains a blurred surface + border the moment you scroll,
// plus a thin gold scroll-progress hairline. No React/framer-motion here —
// it's a ~20-line vanilla script instead, since this is a static multi-page
// site and shipping a JS framework runtime just for this would undercut the
// entire reason this project is Astro (fast, crawlable, no hydration tax).
//
// Departure from the order-engine convention: that engine deliberately
// never uses a client logo file (quality varies too much client to client).
// For Indian Flavors specifically, the client's actual gold emblem (cropped
// from their real storefront photography, not a vector supplied by them) is
// strong enough to be worth the exception — a real mark reads as more
// "wow" than typography alone. If a future client's logo photography isn't
// this clean, fall back to the typographic-only header.
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { LANGUAGES, LANGUAGE_LABEL, LANGUAGE_NATIVE_NAME, localizedPath, arrow, t, type Language } from '../i18n/languages';
import { nav as navUi } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;
const orderCtaLabel = getOrderCtaLabel(lang);

const nav = [
  { href: '/', label: t(navUi.accueil, lang) },
  { href: '/menu', label: t(navUi.menu, lang) },
  { href: '/a-propos', label: t(navUi.aPropos, lang) },
  { href: '/reservation', label: t(navUi.reservation, lang) },
  { href: '/faq', label: t(navUi.faq, lang) },
  { href: '/contact', label: t(navUi.contact, lang) },
].map((item) => ({ ...item, href: localizedPath(item.href, lang) }));

// Current path with the OTHER languages' equivalent URLs, for the
// switcher — same page, different language, never the homepage of that
// language regardless of where you currently are on the site.
const currentPath = Astro.url.pathname;
const langLinks = LANGUAGES.map((l) => ({ lang: l, href: localizedPath(currentPath, l) }));
// Same list, minus the language already active — this is what the mobile
// dropdown offers (the active one is already shown as the toggle's own
// label, so repeating it inside the dropdown would be redundant).
const otherLangLinks = langLinks.filter((l) => l.lang !== lang);
---
<header id="site-header" class="sticky top-0 z-40 transition-all duration-300" data-scrolled="false">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    <a href={localizedPath('/', lang)} class="flex items-center min-w-0 shrink-0">
      <img
        src="/images/logo-mark-transparent.webp"
        alt={siteConfig.identity.name}
        width="325"
        height="186"
        class="h-9 sm:h-11 w-auto shrink-0"
      />
    </a>

    <nav class="hidden md:flex items-center gap-7 shrink-0">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-semibold transition-colors"
          style={`color: ${currentPath === item.href ? 'var(--color-accent)' : 'var(--color-text-primary)'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language switcher (desktop) — real links to the same page's
         other-language URL (see langLinks above), not a JS toggle: each is
         an actual separately-crawlable static page (see astro.config.mjs's
         i18n comment for why that matters here). Desktop-only now (md and
         up) — on mobile this three-pill row ate too much of an already
         tight header, competing with the logo and the hamburger toggle for
         the same handful of pixels. Mobile gets its own compact
         single-button dropdown instead, see below. -->
    <div class="hidden md:flex items-center gap-1 shrink-0 rounded-full p-0.5" style="border: 1px solid var(--color-border)">
      {langLinks.map((l) => (
        <a
          href={l.href}
          aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
          aria-current={lang === l.lang ? 'true' : undefined}
          class="px-2 py-1 rounded-full text-xs font-bold transition-colors"
          style={`color: ${lang === l.lang ? 'var(--color-background)' : 'var(--color-text-muted)'}; background-color: ${lang === l.lang ? 'var(--color-accent)' : 'transparent'}`}
        >
          {LANGUAGE_LABEL[l.lang]}
        </a>
      ))}
    </div>

    <a
      href={orderCtaLabel.href}
      class="hidden sm:inline-flex items-center gap-1.5 text-sm font-bold shrink-0"
      style="color: var(--color-accent)"
    >
      {orderCtaLabel.label} {arrow(lang)}
    </a>

    <!-- Mobile-only right-hand cluster: language toggle + hamburger,
         grouped in one wrapper so they stay glued together as a single
         unit. Fix: these two used to be separate top-level flex children
         in the header row. With `justify-between` and only 3 visible items
         on real mobile widths (logo, lang toggle, hamburger — nav/desktop
         pills/CTA are all hidden below sm/md), the layout distributes the
         leftover space evenly across both gaps, which pushes the middle
         item (the lang toggle) toward the horizontal center of the header
         instead of sitting next to the hamburger. Wrapping both in one
         `md:hidden` flex container turns them into a single flex child, so
         `justify-between` only ever has two things to space apart (logo
         and this cluster) and the cluster itself stays pinned to the right
         edge, lang toggle immediately left of the hamburger. -->
    <div class="flex items-center gap-2 md:hidden shrink-0">
      <!-- Language switcher (mobile) — a single button showing the active
           language's code. Tapping it drops a small panel down with the
           other two languages; tapping one of those navigates straight to
           that page's equivalent URL, same real-link behavior as the
           desktop pills (no client-side language switching, still a
           proper crawlable page per language). Kept as its own block (not
           just a responsive variant of the desktop pills) since the two
           need genuinely different markup: a row of three links vs. one
           button + an absolutely-positioned panel. -->
      <div class="relative shrink-0">
        <button
          id="mobile-lang-toggle"
          type="button"
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-full text-[11px] font-bold transition-colors"
          style="border: 1px solid var(--color-border); color: var(--color-text-primary)"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={LANGUAGE_NATIVE_NAME[lang]}
        >
          {LANGUAGE_LABEL[lang]}
          <svg id="mobile-lang-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="mobile-lang-panel"
          class="hidden flex-col absolute right-0 top-full mt-2 min-w-[7rem] rounded-xl overflow-hidden z-50"
          style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 12px 32px rgba(0,0,0,0.4)"
        >
          {otherLangLinks.map((l) => (
            <a
              href={l.href}
              aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
              class="px-4 py-2.5 text-sm font-semibold"
              style="color: var(--color-text-primary)"
            >
              {LANGUAGE_NATIVE_NAME[l.lang]}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile nav toggle -->
      <button id="mobile-nav-toggle" class="shrink-0" aria-label="Menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--color-text-primary)">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav-panel" class="md:hidden hidden flex-col px-4 pb-4" style="background-color: var(--color-surface)">
    {nav.map((item) => (
      <a href={item.href} class="py-2.5 text-sm font-semibold" style="color: var(--color-text-primary)">
        {item.label}
      </a>
    ))}
    <!-- Language options are no longer repeated here — mobile has its own
         dropdown next to the hamburger now (see above), so duplicating
         them inside this panel too would just be clutter. -->
    <a
      href={orderCtaLabel.href}
      class="mt-3 pt-3 py-2.5 text-sm font-bold"
      style="border-top: 1px solid var(--color-border); color: var(--color-accent)"
    >
      {orderCtaLabel.label} {arrow(lang)}
    </a>
  </div>

  <div class="h-px w-full transition-colors duration-300" id="header-track">
    <div id="header-progress" class="h-full" style="width: 0%; background-color: var(--color-accent)"></div>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  /* Scrolled state now carries a touch of the same wine-red used in the
     section bands below (color-mix'd into --color-surface first, then
     that result mixed toward transparent for the blur) instead of being
     the one part of the site that stays neutral grey no matter what page
     you're on. Still subtle — this is the header, restraint matters most
     here — but it means the "opening" moment ties back to the brand. */
  #site-header[data-scrolled='true'] {
    background-color: color-mix(in srgb, color-mix(in srgb, var(--color-primary-dark) 10%, var(--color-surface)) 95%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  #header-track {
    background-color: transparent;
  }
  #site-header[data-scrolled='true'] #header-track {
    background-color: var(--color-border);
  }
  #mobile-nav-panel.open {
    display: flex;
  }
  #mobile-lang-panel.open {
    display: flex;
  }
  #mobile-lang-chevron.open {
    transform: rotate(180deg);
  }
</style>

<script>
  // Wrapped in 'astro:page-load' (fires on first load AND after every View
  // Transitions client-side navigation — see Layout.astro's scripts for the
  // same pattern). The header re-renders on every navigation (different
  // active nav item, different lang-switcher state per page), so its old
  // DOM nodes and any listeners bound to them are gone after a transition;
  // this re-queries fresh nodes and rebinds every time instead of only once.
  // `scrollHandler` / `outsideClickHandler` are tracked at module scope
  // purely to remove the previous page's `window`/`document` listeners
  // first — those objects aren't swapped between navigations, so without
  // this, every navigation would stack another listener on top instead of
  // replacing it.
  let scrollHandler = null;
  let outsideClickHandler = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const progress = document.getElementById('header-progress');
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const langToggle = document.getElementById('mobile-lang-toggle');
    const langPanel = document.getElementById('mobile-lang-panel');
    const langChevron = document.getElementById('mobile-lang-chevron');

    function onScroll() {
      if (!header || !progress) return;
      const scrolled = window.scrollY > 8;
      header.dataset.scrolled = String(scrolled);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      progress.style.width = `${pct * 100}%`;
    }
    onScroll();

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    scrollHandler = onScroll;
    window.addEventListener('scroll', scrollHandler, { passive: true });

    toggle?.addEventListener('click', () => {
      const isOpen = panel?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    // Mobile language dropdown: toggles open/closed on tap, and — unlike
    // the hamburger panel, which the visitor closes deliberately — also
    // closes itself on any tap outside it, since a language picker left
    // open over the page content would otherwise sit there blocking taps
    // on whatever's underneath.
    langToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = langPanel?.classList.toggle('open');
      langToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      langChevron?.classList.toggle('open', Boolean(isOpen));
    });

    if (outsideClickHandler) document.removeEventListener('click', outsideClickHandler);
    outsideClickHandler = (event) => {
      if (!langPanel?.classList.contains('open')) return;
      const target = event.target;
      if (langToggle?.contains(target) || langPanel?.contains(target)) return;
      langPanel.classList.remove('open');
      langToggle?.setAttribute('aria-expanded', 'false');
      langChevron?.classList.remove('open');
    };
    document.addEventListener('click', outsideClickHandler);
  });
</script>
