---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';
import { t, localizedPath, type Language } from '../i18n/languages';
import { common, place } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'fr' } = Astro.props;
const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);
const orderCtaLabel = getOrderCtaLabel(lang);

const copy = {
  metaTitle: {
    fr: `Menu — ${primaryKeyword} à ${city} | ${name}`,
    en: `Menu — ${primaryKeyword} in ${city} | ${name}`,
    ar: `القائمة — ${primaryKeyword} في ${city} | ${name}`,
  },
  metaDescription: {
    fr: `Découvrez le menu complet de ${name}, ${primaryKeyword} à ${city} : sushis, plats fusion asiatique et cocktails signature. Réservez votre table ou commandez en ligne.`,
    en: `Discover the full menu of ${name}, ${primaryKeyword} in ${city}: sushi, Asian fusion dishes and signature cocktails. Book your table or order online.`,
    ar: `اكتشف القائمة الكاملة لـ${name}, ${primaryKeyword} في ${city}: سوشي، أطباق فيوجن آسيوية وكوكتيلات مميزة. احجز طاولتك أو اطلب أونلاين.`,
  },
  heroAlt: {
    fr: `Plats du menu de ${name}`,
    en: `Dishes from ${name}'s menu`,
    ar: `أطباق من قائمة ${name}`,
  },
  heroTitle: { fr: `Le menu de notre ${primaryKeyword}`, en: `Our ${primaryKeyword}'s menu`, ar: `قائمة ${primaryKeyword} الخاص بنا` },
  heroSubtitle: {
    fr: 'Une sélection de nos plats signature. Le menu complet, avec toutes les options et suppléments, est disponible au moment de la commande.',
    en: 'A selection of our signature dishes. The full menu, with all options and extras, is available at the time of ordering.',
    ar: 'تشكيلة من أطباقنا المميزة. القائمة الكاملة، بجميع الخيارات والإضافات، متوفرة عند الطلب.',
  },
  readyToOrder: { fr: 'Prêt à commander ?', en: 'Ready to order?', ar: 'جاهز للطلب؟' },
  searchPlaceholder: { fr: 'Rechercher un plat…', en: 'Search a dish…', ar: 'ابحث عن طبق…' },
  searchLabel: { fr: 'Rechercher dans le menu', en: 'Search the menu', ar: 'البحث في القائمة' },
  jumpNavLabel: { fr: 'Aller à une catégorie', en: 'Jump to a category', ar: 'الانتقال إلى قسم' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const menuJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu — ${name}`,
  hasMenuSection: menuHighlights.map((cat) => ({
    '@type': 'MenuSection',
    name: t(cat.label, lang),
    hasMenuItem: cat.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: t(item.description, lang),
      offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
    })),
  })),
};

const path = localizedPath('/menu', lang);
---

<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={menuJsonLd}
>
  <!-- Menu's own bolder opening moment — every interior page used the same
       compact PageHero, which made the whole site feel like one page
       repeated. Menu gets the exception: taller, with the same Ken Burns
       drift as the Home spotlight, since this is the page people actually
       linger on. Home stays the one full-height "big" hero — this is a
       step up from PageHero, not a rival to Home. -->
  <section class="relative min-h-[420px] sm:h-[64vh] flex items-end overflow-hidden" data-reveal="scale">
    <div class="ken-burns absolute inset-0">
      <img
        src="/images/dish-nara-roll.webp"
        alt={t(copy.heroAlt, lang)}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    <div class="absolute inset-0" style="background: linear-gradient(0deg, var(--color-background) 12%, rgba(11,11,12,0.4) 55%, rgba(11,11,12,0.6) 100%)"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-12 sm:pb-16 w-full">
      <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-3" style="color: var(--color-accent)">{city}</span>
      <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-semibold" style="color: var(--color-text-primary)">
        {t(copy.heroTitle, lang)}
      </h1>
      <p class="mt-4 max-w-xl text-sm sm:text-base" style="color: var(--color-text-muted)">
        {t(copy.heroSubtitle, lang)}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-5 sm:px-8 pt-8 pb-4">
    <div>
      <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
    </div>
  </section>

  <!-- Typographic moment — same oversized-number language as À propos,
       repeated here instead of only appearing on one page of the site. -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pt-4 pb-10 sm:pb-14 flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-10" data-reveal>
    <p class="stat-huge">100%</p>
    <p class="max-w-sm text-sm sm:text-base sm:pb-1" style="color: var(--color-text-muted)">
      {t(common.preparesCommandeLine, lang)}
    </p>
  </section>

  <!-- Filter (final punch-list item #3) — a real, useful interaction, not
       decoration: the FAQ already states a large part of the menu is
       vegetarian, but until now a visitor had to scan every card to find
       those dishes. Client-side only (show/hide, no reload) — deliberately
       just "Végétarien", not a fuller vegan/spice-level filter, since
       vegetarian is the one dietary fact readable straight off each dish's
       own description; see menu-highlights.ts's comment for why. Also the
       scroll anchor every category's "back to top" link jumps to. -->
  <section id="menu-options" class="max-w-7xl mx-auto px-5 sm:px-8 pb-6 scroll-mt-24" data-reveal>
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-4">
      <div class="menu-search-wrap sm:max-w-xs w-full">
        <svg class="menu-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" />
        </svg>
        <input
          type="text"
          id="menu-search"
          class="menu-search-input"
          placeholder={t(copy.searchPlaceholder, lang)}
          aria-label={t(copy.searchLabel, lang)}
        />
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="menu-filter-btn is-active" data-filter="all">{t(common.toutLeMenu, lang)}</button>
        <button type="button" class="menu-filter-btn" data-filter="vegetarian">🌱 {t(common.vegetarienUniquement, lang)}</button>
      </div>
    </div>
    <nav class="menu-jump-scroll" aria-label={t(copy.jumpNavLabel, lang)}>
      {menuHighlights.map((category, i) => (
        <a href={`#cat-${i}`} class="menu-jump-chip" data-jump>{t(category.label, lang)}</a>
      ))}
    </nav>
  </section>

  <!-- Alternating band now goes warm (--color-primary-dark) instead of
       plain grey — the deep wine tone from the order-engine, applied
       here rather than À propos/Avis because it's food, and warmth fits
       a menu the way it doesn't fit an editorial about-page. -->
  {menuHighlights.map((category, i) => (
    <div id={`cat-${i}`} class={`scroll-mt-28 sm:scroll-mt-32 ${i % 2 === 1 ? 'section-tint-warm' : ''}`} data-menu-category>
      <section class="max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
        <div>
          <h2
            class="font-display text-2xl font-semibold mb-5 pb-3 flex items-baseline gap-3"
            style="color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)"
          >
            <span class="text-xs font-bold" style="color: var(--color-accent)">{String(i + 1).padStart(2, '0')}</span>
            {t(category.label, lang)}
          </h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {category.items.map((item, j) => (
              <div
                class="card-lift flex items-start gap-4 rounded-xl p-4"
                style={`background-color: ${i % 2 === 1 ? 'color-mix(in srgb, var(--color-primary-dark) 14%, var(--color-surface-muted))' : 'var(--color-surface)'}; border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
                data-reveal
                data-veg={item.vegetarian ? 'true' : 'false'}
                data-search={`${item.name} ${t(item.description, lang)}`}
              >
                <div class="min-w-0 flex-1">
                  <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">
                    {item.name}
                    {item.vegetarian && <span class="text-xs align-middle" title={t(common.vegetarienUniquement, lang)}>🌱</span>}
                  </h3>
                  <p class="text-sm mt-1" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
                </div>
                <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
              </div>
            ))}
          </div>
        </div>
      </section>
      <div class="max-w-7xl mx-auto px-5 sm:px-8 pb-2 text-center">
        <a href="#menu-options" class="menu-back-to-top">↑ {t(common.retourAuxOptions, lang)}</a>
      </div>
    </div>
  ))}

  <Ornament />

  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 text-center">
    <p class="text-sm mb-4" style="color: var(--color-text-muted)">{t(copy.readyToOrder, lang)}</p>
    <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
  </section>
</Layout>

<style>
  .menu-filter-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .menu-filter-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .menu-filter-btn:not(.is-active):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .menu-back-to-top {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .menu-back-to-top:hover {
    color: var(--color-accent);
  }

  .menu-search-wrap {
    position: relative;
  }
  .menu-search-icon {
    position: absolute;
    inset-inline-start: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .menu-search-input {
    width: 100%;
    padding-block: 0.6rem;
    padding-inline-start: 2.5rem;
    padding-inline-end: 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    transition: border-color 0.15s ease;
  }
  .menu-search-input::placeholder {
    color: var(--color-text-muted);
  }
  .menu-search-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .menu-jump-chip {
    flex: 0 0 auto;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .menu-jump-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Glovo-style horizontal scroll strip for the jump-chip row. */
  .menu-jump-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    padding-block: 2px;
    mask-image: linear-gradient(to right, transparent, black 20px, black calc(100% - 20px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 20px, black calc(100% - 20px), transparent);
  }
  .menu-jump-scroll::-webkit-scrollbar {
    display: none;
  }
  [dir='rtl'] .menu-jump-scroll {
    mask-image: linear-gradient(to left, transparent, black 20px, black calc(100% - 20px), transparent);
    -webkit-mask-image: linear-gradient(to left, transparent, black 20px, black calc(100% - 20px), transparent);
  }
  @media (min-width: 640px) {
    .menu-jump-scroll {
      margin-inline: -2rem;
      padding-inline: 2rem;
    }
  }
</style>

<script>
  // Client-side only, no reload — see the filter section's comment above
  // for why this exists and why it's scoped to "vegetarian" specifically.
  // Wrapped in 'astro:page-load' (same pattern as Layout.astro's sitewide
  // scripts) so this re-initializes correctly if the Menu page is reached
  // via a View Transitions client-side navigation, not just a hard load.
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll('.menu-filter-btn');
    const searchInput = document.getElementById('menu-search');
    const jumpChips = document.querySelectorAll('[data-jump]');
    const items = document.querySelectorAll('[data-veg]');
    const categories = document.querySelectorAll('[data-menu-category]');

    if (!filterButtons.length && !searchInput) return;

    let activeFilter = 'all';

    // Accent-insensitive match ("epices" also finds "épices") — a visitor
    // typing on a phone shouldn't need the right diacritics to find a dish.
    function normalize(str) {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function applyFilters() {
      const query = normalize(searchInput?.value.trim() ?? '');
      items.forEach((item) => {
        const isVeg = item.getAttribute('data-veg') === 'true';
        const matchesFilter = activeFilter === 'all' || isVeg;
        const matchesQuery = !query || normalize(item.getAttribute('data-search') ?? '').includes(query);
        item.style.display = matchesFilter && matchesQuery ? '' : 'none';
      });

      categories.forEach((cat) => {
        const hasVisibleItem = Array.from(cat.querySelectorAll('[data-veg]')).some((item) => item.style.display !== 'none');
        cat.style.display = hasVisibleItem ? '' : 'none';
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeFilter = btn.getAttribute('data-filter');
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    // Intercept the jump chips so the scroll target respects scroll-mt
    // (the sticky order bar's height) the same way as a plain #hash
    // navigation would — smooth on top of that, not instead of it.
    jumpChips.forEach((chip) => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.querySelector(chip.getAttribute('href'));
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    applyFilters();
  });
</script>
